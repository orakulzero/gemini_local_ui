{
  "manifest_version": 3,
  "name": "MOiAD Gemini Learning Harvester & Cookie Sync",
  "version": "2.0",
  "description": "Real-time Gemini Guided Learning ⇄ Antigravity (Variant 8 Verifier) ⇄ Obsidian Live Vault bridge + Cookie Sync.",
  "permissions": [
    "cookies",
    "downloads",
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://google.com/*",
    "https://*.google.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "MOiAD Gemini Learning Harvester",
    "default_popup": "popup.html"
  }
}
