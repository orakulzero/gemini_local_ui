{
  "manifest_version": 3,
  "name": "Gemini Cookie Sync",
  "version": "2.0",
  "description": "Gemini Cookie Sync",
  "permissions": [
    "cookies",
    "downloads",
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://google.com/*",
    "https://*.google.com/*",
    "https://notebooklm.google.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Gemini Cookie Sync",
    "default_popup": "popup.html"
  }
}
